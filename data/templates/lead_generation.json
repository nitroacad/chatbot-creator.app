          "inputType": "email",
          "variableName": "user_email",
          "text": "Thanks! What is your email address so our team can follow up with you?",
          "nextStepId": "step_3"
        },
        {
          "id": "step_3",
          "type": "message",
          "text": "Got it! Your inquiry has been forwarded to our support queue. An agent will respond within 24 hours.",
          "nextStepId": "end"
        }
      ]
